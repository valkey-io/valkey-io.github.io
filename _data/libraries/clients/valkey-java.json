{
  "name": "valkey-java",
  "language": "Java",
  "license": "MIT",
  "description": "The Jedis-derived Java client maintained under valkey-io. Blocking API, connection pooling and cluster support.",
  "repository": "https://github.com/valkey-io/valkey-java",
  "documentation": "https://github.com/valkey-io/valkey-java/blob/v5.5.0/README.md#getting-started",
  "installCommand": "implementation 'io.valkey:valkey-java:5.+'",
  "features": {
    "replica": false,
    "backoff": true,
    "pubsub": false,
    "scan": false,
    "latency": false,
    "az": false,
    "csc": false,
    "capa": true,
    "pool": true
  }
}
