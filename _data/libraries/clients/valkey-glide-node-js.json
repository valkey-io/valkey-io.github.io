{
  "name": "Valkey GLIDE Node.js",
  "language": "Node.js",
  "license": "Apache-2.0",
  "description": "Designed for reliability, optimized performance, and high-availability. GLIDE is a multi-language client with one shared Rust core and per-language bindings.",
  "repository": "https://github.com/valkey-io/valkey-glide/tree/main/node",
  "documentation": "https://glide.valkey.io/getting-started/quickstart/?lang=node",
  "installCommand": "npm install @valkey/valkey-glide",
  "features": {
    "replica": true,
    "backoff": true,
    "pubsub": true,
    "scan": true,
    "latency": false,
    "az": true,
    "csc": false,
    "capa": false,
    "pool": false
  },
  "type": "clients"
}
